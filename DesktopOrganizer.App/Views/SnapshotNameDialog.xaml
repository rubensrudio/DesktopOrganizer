<Window x:Class="DesktopOrganizer.App.Views.SnapshotNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Novo snapshot"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=NameTextBox}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Nome do snapshot:"
                   Margin="0,0,0,6"
                   AutomationProperties.Name="Nome do snapshot" />

        <TextBox x:Name="NameTextBox"
                 Grid.Row="1"
                 Padding="6,4"
                 KeyDown="NameTextBox_KeyDown"
                 AutomationProperties.LabeledBy="{Binding ElementName=NameTextBox}" />

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="OkButton"
                    Content="OK"
                    Width="88"
                    Height="28"
                    IsDefault="True"
                    Click="OkButton_Click"
                    Margin="0,0,8,0" />
            <Button x:Name="CancelButton"
                    Content="Cancelar"
                    Width="88"
                    Height="28"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
